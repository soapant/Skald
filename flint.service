[Unit]
Description=Custom keyboard remapper
# FIX: Was `After=multi-user.target` + WantedBy=multi-user.target as a SYSTEM service.
# That runs as root before the graphical session, with no DISPLAY/WAYLAND_DISPLAY/XAUTHORITY/XDG_RUNTIME_DIR
# and wrong WorkingDirectory. Result: `Authorization required` / `Failed to open X11 display`,
# and hotkeys reading /dev/input as root cannot forward to the user's Wayland session.
# This must be a USER service: ~/.config/systemd/user/flint.service
After=graphical-session.target
PartOf=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# data/ paths (data/todo.txt etc.) are relative -> project dir contains a space, so we
# cannot use WorkingDirectory= with systemd's parsing. Use a shell wrapper that cd's first.
# Alternative robust fix: sudo cp build/flint /usr/local/bin/flint and use WorkingDirectory=/home/diggy/Programming/Projects/C\ Code
ExecStart=/bin/sh -c 'cd "/home/diggy/Programming/Projects/C Code" && exec "/home/diggy/Programming/Projects/C Code/build/flint"'
# Inherit Wayland/X11 env from user manager. Ensure after login you run:
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XAUTHORITY
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XAUTHORITY
Environment=XDG_RUNTIME_DIR=%t
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
WantedBy=graphical-session.target

# NOTE: There must be exactly ONE copy of this unit installed.
# If an OLD root-level unit also exists (/etc/systemd/system/flint.service),
# both start on boot -> two instances fighting over /dev/input.
# Remove it with:
#   sudo systemctl disable --now flint.service
#   sudo rm /etc/systemd/system/flint.service
# The binary itself also refuses to run twice (flock /tmp/flint.lock).
#
# Env import after login (needed for DISPLAY/XAUTHORITY so prompts work):
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XAUTHORITY
